# Vexa Local: archivos locales y artefactos que no deben publicarse.
# Las reglas específicas de la aplicación están en Codigo/.gitignore.

# Python y pruebas
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
**/.pytest_*/
**/.pytest-*/
*.egg-info/

# Entornos locales
.venv/
venv/
env/

# Secretos y configuración local (solo se versiona la plantilla)
.env
.env.*
!.env.example
!.env.docker.example

# Datos de VEXA, credenciales, índices, respaldos y logs
.vexa_local/
instance/
case_documents/
*.db
*.sqlite
*.sqlite3
*.log
*.bak
*.vexabackup

# Empaquetado (desktop/build.ps1 regenera el .spec de PyInstaller)
build/
dist/
*.spec
node_modules/
**/desktop/backend/build/
**/desktop/backend/dist/
**/desktop/electron/release/

# Editores / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Sistema operativo / OneDrive
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Temporales de Office y archivos temporales
~$*
*.tmp
