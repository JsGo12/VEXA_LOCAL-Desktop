# Ajustes opcionales del contenedor VEXA. Copia como .env.docker (no se versiona).
# Lo fijo (loopback, /data, Tailscale activo, Ollama en 127.0.0.1) está en docker-compose.yml.

# Modelo de chat fijo (vacío = automático según la RAM del contenedor). Ej.: llama3.2:1b
VEXA_CHAT_MODEL=
VEXA_EMBED_MODEL=bge-m3
VEXA_OLLAMA_KEEP_ALIVE=5m

# IP 100.x del CONTENEDOR (docker compose exec tailscale tailscale ip -4). Vacía = autodetección.
TAILSCALE_BIND_ADDRESS=
# Nombre MagicDNS del contenedor, ej. vexa-servidor.tu-red.ts.net
TAILSCALE_HOST=

# Vacía (recomendado) = /data/web_secret.key generada por VEXA.
VEXA_SECRET_KEY=
# Usuario/contraseña del administrador inicial (solo si la base está vacía).
VEXA_ADMIN_USERNAME=
VEXA_ADMIN_PASSWORD=
