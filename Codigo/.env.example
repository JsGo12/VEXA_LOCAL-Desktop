# VEXA Local — plantilla de configuración. Copia este archivo como `.env` (no se versiona) con:
#   python backend\scripts\init_env.py
# Las variables del entorno del proceso tienen prioridad sobre este archivo. Detalle: docs/configuracion.md

# --- Aplicación -------------------------------------------------------------
# development | production  (en production no se permite el servidor de desarrollo de Flask)
VEXA_ENV=development
# waitress (recomendado) | flask (solo desarrollo)
VEXA_SERVER=waitress
# Solo loopback. VEXA nunca escucha en 0.0.0.0; para acceso remoto privado usa Tailscale (abajo).
VEXA_HOST=127.0.0.1
VEXA_PORT=5000
# Hilos de Waitress (consultas simultáneas). 8 es suficiente para un estudio pequeño.
VEXA_THREADS=8
# DEBUG | INFO | WARNING | ERROR
VEXA_LOG_LEVEL=INFO

# --- Secretos ----------------------------------------------------------------
# Clave de firma de sesiones de Flask (>= 32 caracteres). Vacía = VEXA usa
# <VEXA_DATA_DIR>\web_secret.key, generada localmente y cifrada con DPAPI (recomendado).
# NO es la clave de cifrado de documentos (esa vive en vault.key y nunca se configura aquí).
VEXA_SECRET_KEY=
# Administrador inicial (solo se usan si la base aún no tiene administrador).
# Vacío = usuario "admin" y contraseña aleatoria escrita en credenciales_admin_inicial.txt.
VEXA_ADMIN_USERNAME=
VEXA_ADMIN_PASSWORD=

# --- Datos locales -----------------------------------------------------------
# Vacío = %USERPROFILE%\.vexa_local (fuera del repositorio y de OneDrive). No muevas los datos
# existentes cambiando esta ruta: la base guarda rutas absolutas de los documentos cifrados.
VEXA_DATA_DIR=
# Vacío = <VEXA_DATA_DIR>\vexa_web.db
VEXA_DB_PATH=
# Vacío = <VEXA_DATA_DIR>\carpeta_vigilada
VEXA_WATCH_DIR=
# true solo si VEXA se publica por HTTPS (por ejemplo, con `tailscale serve`).
VEXA_SESSION_COOKIE_SECURE=false

# --- IA local (Ollama) -------------------------------------------------------
# Debe ser 127.0.0.1/localhost: VEXA rechaza servidores de IA externos.
OLLAMA_HOST=http://127.0.0.1:11434
# Modelo de chat forzado (vacío = selección automática según RAM/GPU).
VEXA_CHAT_MODEL=
VEXA_EMBED_MODEL=bge-m3
# Tiempo que Ollama mantiene el modelo cargado (0 = descargar al terminar).
VEXA_OLLAMA_KEEP_ALIVE=5m
# Ruta de tesseract.exe si Windows no lo encuentra (OCR de PDF escaneados).
VEXA_TESSERACT_CMD=

# --- Acceso privado con Tailscale (opcional) --------------------------------
# false = solo este equipo. true = escucha además en la IP 100.x de Tailscale (nunca Funnel).
TAILSCALE_ENABLED=false
# IP de Tailscale de este equipo (`tailscale ip -4`). Vacía = detección automática.
TAILSCALE_BIND_ADDRESS=
# Puerto en la interfaz de Tailscale (vacío = VEXA_PORT).
TAILSCALE_PORT=
# Nombre MagicDNS del equipo (ej. servidor-vexa.tu-red.ts.net) para aceptarlo como Host.
TAILSCALE_HOST=
